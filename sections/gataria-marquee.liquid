{% schema %}
{
  "name": "Gataria Marquee",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Marquee Text",
      "default": "• Estampas Exclusivas ✨ • Miau! Promoções Imperdíveis 🐱 • "
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#4ECDC4"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "speed",
      "min": 5,
      "max": 30,
      "step": 1,
      "unit": "s",
      "label": "Animation Speed",
      "default": 15
    }
  ],
  "presets": [
    {
      "name": "Gataria Marquee"
    }
  ]
}
{% endschema %}

<div class="gataria-marquee-container" style="background-color: {{ section.settings.background_color }};">
  <div class="gataria-marquee-content" style="animation-duration: {{ section.settings.speed }}s;">
    <span style="color: {{ section.settings.text_color }};">{{ section.settings.text }}</span>
    <span style="color: {{ section.settings.text_color }};">{{ section.settings.text }}</span>
    <span style="color: {{ section.settings.text_color }};">{{ section.settings.text }}</span>
    <span style="color: {{ section.settings.text_color }};">{{ section.settings.text }}</span>
  </div>
</div>
